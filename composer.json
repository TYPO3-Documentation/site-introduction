{
	"name": "typo3/cms-base-distribution",
	"description" : "TYPO3 CMS Base Distribution",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true
	},
	"repositories": [
		{
			"type": "path",
			"url": "packages/*"
		}
	],
	"require": {
		"friendsoftypo3/content-blocks": "^2.0",
		"t3docs/site-package": "@dev",
		"typo3/cms-backend": "^14.3.0",
		"typo3/cms-belog": "^14.3.0",
		"typo3/cms-beuser": "^14.3.0",
		"typo3/cms-core": "^14.3.0",
		"typo3/cms-dashboard": "^14.3.0",
		"typo3/cms-extbase": "^14.3.0",
		"typo3/cms-extensionmanager": "^14.3.0",
		"typo3/cms-felogin": "^14.3.0",
		"typo3/cms-filelist": "^14.3.0",
		"typo3/cms-fluid": "^14.3.0",
		"typo3/cms-fluid-styled-content": "^14.3.0",
		"typo3/cms-form": "^14.3.0",
		"typo3/cms-frontend": "^14.3.0",
		"typo3/cms-impexp": "^14.3.0",
		"typo3/cms-info": "^14.3.0",
		"typo3/cms-install": "^14.3.0",
		"typo3/cms-reactions": "^14.3.0",
		"typo3/cms-rte-ckeditor": "^14.3.0",
		"typo3/cms-seo": "^14.3.0",
		"typo3/cms-setup": "^14.3.0",
		"typo3/cms-sys-note": "^14.3.0",
		"typo3/cms-t3editor": "^14.3.0",
		"typo3/cms-tstemplate": "^14.3.0",
		"typo3/cms-viewpage": "^14.3.0",
		"typo3/cms-webhooks": "^14.3.0"
	}
}
